    {
      "name": "01 닉네임 중복",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/%EC%88%98%ED%98%84"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"available\",()=>pm.expect(pm.response.json()).to.eql({available:false}));"
            ]
          }
        }
      ]
    },
