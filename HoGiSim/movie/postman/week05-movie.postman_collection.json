            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"최신순 DTO\",()=>{const r=pm.response.json();pm.expect(r).to.have.lengthOf(2);pm.expect(r[0].ratingId).to.be.above(r[1].ratingId);r.forEach(v=>pm.expect(v).to.have.all.keys(\"ratingId\",\"movieId\",\"score\",\"comment\",\"createdAt\",\"updatedAt\"));});"
            ]
          }
        }
