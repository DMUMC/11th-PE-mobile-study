{
  "info": {
    "name": "HoGiSim 4주차 ORM 도서 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "필수 미션 및 선택 3개 검증. 실행 전 npm run start:prod. categoryId는 실제 카테고리 PK로 지정합니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "missingCategoryId",
      "value": "2147483647"
    },
    {
      "key": "runTitle",
      "value": "워크북검증"
    }
  ],
  "item": [
    {
      "name": "01 전체 도서 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"응답 DTO와 최신순 정렬\", function () { const rows = pm.response.json(); pm.expect(rows).to.be.an(\"array\"); rows.forEach(function (book, i) { pm.expect(book).to.have.all.keys(\"bookId\", \"title\", \"description\", \"categoryName\", \"isAvailable\"); pm.expect(book.isAvailable).to.be.a(\"boolean\"); if (i > 0) pm.expect(rows[i-1].bookId).to.be.above(book.bookId); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 도서 등록 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"{{runTitle}}\",\n  \"description\": \"4주차 Postman 검증\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runTitle\", \"워크북검증-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"등록 응답\", function () { const book = pm.response.json(); pm.expect(book.title).to.eql(pm.collectionVariables.get(\"runTitle\")); pm.expect(book.isAvailable).to.eql(true); pm.expect(book.categoryName).to.be.a(\"string\"); pm.collectionVariables.set(\"createdBookId\", book.bookId); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 등록한 제목 검색",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books?keyword={{runTitle}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"검색 결과\", function () { const rows = pm.response.json(); pm.expect(rows).to.have.lengthOf(1); pm.expect(rows[0].bookId).to.eql(Number(pm.collectionVariables.get(\"createdBookId\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 중복 제목 차단",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"{{runTitle}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 빈 제목 검증",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 공백 제목 검증",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 없는 카테고리 검증",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{missingCategoryId}},\n  \"title\": \"{{runTitle}}-없는카테고리\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 검색 결과 없음",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books?keyword={{runTitle}}-없는제목"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"빈 배열\", function () { pm.expect(pm.response.json()).to.eql([]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 100자 초과 제목 검증",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"title\": \"가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}
