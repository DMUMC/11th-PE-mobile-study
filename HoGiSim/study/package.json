{
  "name": "study",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && node --env-file=.env --test test/books.mysql.test.mjs",
    "test:http": "npm run build && node --test test/books.http.test.mjs",
    "db:check": "node --env-file=.env scripts/db-check.mjs",
    "migration:run": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:run -d dist/data-source.js --transaction each",
    "migration:revert": "npm run build && node --env-file=.env node_modules/typeorm/cli.js migration:revert -d dist/data-source.js --transaction each",
    "db:start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-mysql.ps1",
    "db:stop:local": "node --env-file=.env scripts/stop-local-mysql.mjs",
    "test:postman": "newman run postman/week04-books.postman_collection.json --reporters cli,json --reporter-json-export docs/evidence/postman-results.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "newman": "^6.2.3",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
