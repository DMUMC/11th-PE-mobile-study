# 이 파일을 복사해 같은 위치에 .env 파일을 만들고 본인의 TMDB API Read Access Token을 입력하세요.
# .env는 .gitignore에 등록되어 있어 Git에 커밋되지 않습니다.
TMDB_ACCESS_TOKEN=

# MovieLog 자체 API(NestJS) 주소. 비워 두면 자동으로 정해집니다.
#   Android 에뮬레이터: http://10.0.2.2:3000 / iOS 시뮬레이터·웹·데스크톱: http://localhost:3000
# 실제 휴대폰에서 실행할 때만 PC의 IP 주소를 적으세요. (예: http://192.168.0.10:3000)
MOVIELOG_API_BASE_URL=

# 로그인(7주차) 전까지 마이페이지에서 평점을 조회할 회원 id (기본 1 = 시드 데이터 '수현')
MOVIELOG_DEMO_MEMBER_ID=1
