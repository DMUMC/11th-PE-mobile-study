# 이 파일을 복사해 같은 위치에 .env를 만들고 값을 채우세요. .env는 Git에 커밋되지 않습니다.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=umc_movie

# 서버 포트
PORT=3000

# CORS로 허용할 출처 (쉼표로 여러 개 지정)
CORS_ORIGINS=http://localhost:5173

# JWT 서명 키(32자 이상 무작위 문자열)와 Access Token 유효 시간(초)
# 예) node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600
