              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('VALIDATION_ERROR', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_ERROR'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 중복 평점 · 409",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/ratings",
        "header": [
          {
            "key": "X-Member-Id",
            "value": "{{ownerId}}"
          },
          {
            "key": "Content-Type",
