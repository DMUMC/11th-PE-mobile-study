        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "pm.test('DUPLICATE_RATING', () => pm.expect(pm.response.json().code).to.eql('DUPLICATE_RATING'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 저장된 평점 1건 확인 · 200",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/members/{{ownerId}}/ratings",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('중복 저장 없음', () => pm.expect(pm.response.json().filter(r => r.movieId === 157336)).to.have.length(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 타인 평점 수정 · 403",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "header": [
          {
            "key": "X-Member-Id",
            "value": "{{otherId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('RATING_FORBIDDEN', () => pm.expect(pm.response.json().code).to.eql('RATING_FORBIDDEN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 타인 평점 삭제 · 403",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/ratings/{{ratingId}}",
        "header": [
          {
